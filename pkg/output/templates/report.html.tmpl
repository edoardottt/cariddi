{{- /*
HTML report, rendered by HTMLOutput with html/template (see html.go).

The report must be readable offline: everything (CSS, JS, icons) is inline
and the Content-Security-Policy forbids loading any external resource.
*/ -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<title>Cariddi Scan Report</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='254 3 178 178'%3E%3Cstyle%3Epath{fill:%23112b74}@media(prefers-color-scheme:dark){path{fill:%237f9cf0}}%3C/style%3E%3Cpath fill-rule='evenodd' d='{{logoMark}}'/%3E%3C/svg%3E">
<style>
{{style}}</style>
</head>
<body>
<header class="top">
	<div class="wrap">
		<div class="brand">
			<h1><svg width="103" height="32" viewBox="294 4 570 177" role="img" aria-label="Cariddi"><path id="logo-mark" class="logo-mark" fill-rule="evenodd" d="{{logoMark}}"/><path class="logo-text" fill-rule="evenodd" d="{{logoText}}"/></svg></h1>
			<p>Security scanner report</p>
		</div>
		<nav class="links">
			<a href="https://github.com/edoardottt/cariddi" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="https://edoardottt.com" target="_blank" rel="noopener noreferrer">edoardottt.com</a>
			<a href="https://github.com/edoardottt/cariddi/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">GPLv3</a>
		</nav>
	</div>
</header>
<main class="wrap">
<section class="summary">
<div class="summary-head"><h2>Scan summary</h2><span class="muted">Generated {{.Generated}}</span></div>
<div class="stats">
{{- /* Every card with at least one finding links to its section. */}}
{{range .Stats -}}
{{if .Count}}<a class="stat k-{{.ID}}" href="#{{.ID}}">{{else}}<div class="stat k-{{.ID}} empty">{{end -}}
<span class="stat-label"><span class="dot"></span>{{.Label}}</span><span class="stat-value">{{.Count}}</span>
{{- if .Count}}</a>{{else}}</div>{{end}}
{{end -}}
</div>
</section>
<div class="toolbar" hidden>
	<label class="search">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
		<input type="search" placeholder="Filter URLs, secrets, parameters..." autocomplete="off" spellcheck="false" aria-label="Filter findings">
		<kbd>/</kbd>
	</label>
	<span class="filter-status" aria-live="polite"></span>
</div>
{{template "head" (section "results" "Results" (len .Results) "URL")}}
{{- range .Results}}<tr>{{template "url" .}}</tr>
{{end}}
{{- template "foot"}}
{{- with .Secrets}}
{{- template "head" (section "secrets" "Secrets" (len .) "Type" "Match" "URL")}}
{{- range .}}<tr><td>{{.Secret.Name}}</td><td><code>{{.Match}}</code></td>{{template "url" .URL}}</tr>
{{end}}
{{- template "foot"}}
{{- end}}
{{- with .Endpoints}}
{{- template "head" (section "endpoints" "Endpoints" (len .) "Endpoint" "Parameters")}}
{{- range .}}<tr>{{template "url" .URL}}<td>
{{- range $i, $p := .Parameters}}
{{- /* Hidden, it only separates the parameters when copying. */}}
{{- if $i}}<span class="sep">; </span>{{end -}}
<span class="param"><code>{{$p.Parameter}}</code>{{range $p.Attacks}} <span class="tag">{{.}}</span>{{end}}</span>
{{- end -}}
</td></tr>
{{end}}
{{- template "foot"}}
{{- end}}
{{- with .Extensions}}
{{- template "head" (section "extensions" "Extensions" (len .) "Extension" "Level" "URL")}}
{{- range .}}<tr><td><code>{{.Filetype.Extension}}</code></td>
{{- /* Juiciness level of the extension. */ -}}
<td><span class="level lvl-{{.Filetype.Severity}}" title="1 (juicy) to 7 (not juicy)">{{.Filetype.Severity}}</span></td>
{{- template "url" .URL}}</tr>
{{end}}
{{- template "foot"}}
{{- end}}
{{- with .Errors}}
{{- template "head" (section "errors" "Errors" (len .) "Error" "Match" "URL")}}
{{- range .}}<tr><td>{{.Error.ErrorName}}</td><td><code>{{.Match}}</code></td>{{template "url" .URL}}</tr>
{{end}}
{{- template "foot"}}
{{- end}}
{{- with .Infos}}
{{- template "head" (section "info" "Useful information" (len .) "Type" "Match" "URL")}}
{{- range .}}<tr><td>{{.Info.Name}}</td><td><code>{{.Match}}</code></td>{{template "url" .URL}}</tr>
{{end}}
{{- template "foot"}}
{{- end -}}
</main>
<footer>
	<svg width="10" height="18" viewBox="294 4 100 177" aria-hidden="true"><use href="#logo-mark"/></svg>
	<span>Generated by <a href="https://github.com/edoardottt/cariddi" target="_blank" rel="noopener noreferrer">Cariddi</a></span>
</footer>
<script>
{{script}}</script>
</body>
</html>
{{/* Header of a results table, see htmlSection. */ -}}
{{define "head" -}}
<section class="section k-{{.ID}}" id="{{.ID}}">
<button class="copy" type="button" hidden><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg><span>Copy</span></button>
<details open>
<summary><span class="dot"></span><span class="section-title">{{.Title}}</span><span class="count">{{.Count}}</span></summary>
{{/* No whitespace after <tbody>: an empty table must match tbody:empty. */ -}}
<div class="table-wrap"><table><thead><tr>{{range .Columns}}<th>{{.}}</th>{{end}}</tr></thead><tbody>
{{- end}}
{{- define "foot" -}}
</tbody></table></div>
</details>
</section>
{{end}}
{{- /* Only http(s) URLs are clickable, anything else is shown as text. */ -}}
{{define "url" -}}
{{if isHTTP .}}<td class="url"><a href="{{.}}" target="_blank" rel="noopener noreferrer">{{.}}</a></td>
{{- else}}<td class="url">{{.}}</td>
{{- end}}
{{- end -}}
